# Public UDP address taps send audio to. Default = 0.0.0.0:5000
ZK_AEP_BIND_ADDR=0.0.0.0:5000

# Concurrent request ids. Each is a few hundred bytes; this is the memory bound.
# Default = 4096.
ZK_AEP_MAX_ROUTES=4096

# Datagrams held, across all in-flight route lookups together, until the route
# they need is known. The opening packets of a transfer arrive before that, and
# a sender that opens with a burst can lose every one of them at once — which
# kills the transfer rather than costing it a frame. Default = 512.
ZK_AEP_MAX_PENDING=512

# How long a route may sit with no datagram in either direction before it is
# swept. This is what actually bounds the table: HQ writes routes with a
# one-hour TTL and does not always delete them on completion. Default = 300.
ZK_AEP_ROUTE_IDLE_SECONDS=300

# How long a request id with no route is remembered as having none, so a spray
# of guessed ids does not become a Redis load test. Default = 5.
ZK_AEP_NEGATIVE_TTL_SECONDS=5

# Cap on remembered-unroutable ids, held separately from live routes: the ids in
# it are attacker-chosen, and one shared budget would let a spray evict every
# live transfer. Default = 4096.
ZK_AEP_MAX_NEGATIVE=4096

# Shared infrastructure keys, unprefixed as in every other worker.
REDIS_URL=redis://redis:6379
OTLP_ENDPOINT=
# Where /healthz and /metrics are served. UDP cannot be probed, so this is what
# the kubelet checks. Default = 9095.
METRICS_PORT=9095
