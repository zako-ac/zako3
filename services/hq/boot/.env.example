# HQ Application Configuration

BACKEND_ADDRESS=localhost:8080
RPC_ADDRESS=localhost:50052
RPC_ADMIN_TOKEN=sdfgfdsg

# PostgreSQL Connection String
DATABASE_URL=postgres://user:password@localhost:5432/zako3

# TimescaleDB Connection String (for tap metrics time series)
TIMESCALE_DATABASE_URL=postgres://metrics:password@localhost:5433/metrics

# Discord OAuth2 Client Details
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here
DISCORD_REDIRECT_URI=http://localhost:3000/auth/callback

# Discord Bot Token
DISCORD_BOT_TOKEN=your_bot_token_here

# JWT Signing Secret (Generate a strong random string)
JWT_SECRET=your_super_secret_jwt_key_here

# Telemetry (optional)
OTLP_ENDPOINT=http://localhost:5081
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64>,organization=default,stream-name=default
# OTEL_FILTER=debug,h2=off,tonic=off,hyper=off,tower=off,quinn=off,jsonrpsee=off,serenity::gateway=off
METRICS_PORT=9091

REDIS_URL=redis://localhost:6379

# Periodic mapper-cache safety refresh interval (seconds). The in-process mapper cache is
# invalidated via Redis pub/sub on writes; this is the backstop for any missed message. 0 disables it.
MAPPER_CACHE_REFRESH_SECS=300

TRAFFIC_LIGHT_URL=127.0.0.1:7070

# Cache worker RPC — used by admin cache management (clear/delete cached audio).
HQ_CACHE_RPC_URL=http://localhost:4100
# Optional. If the cache worker enforces ZK_CACHE_ADMIN_TOKEN, this must match.
HQ_CACHE_RPC_ADMIN_TOKEN=

# NATS — used to publish fire-and-forget emoji-match requests to the matcher
# worker. Leave empty to disable; HQ will continue to function without it.
NATS_URL=nats://localhost:4222

# Bot Invite Config
SUB_BOT_IDS=                        # Comma-separated sub-bot client IDs
BOT_INVITE_PERMISSIONS=4895026873161728

# -----------------------------------------------------------------------------
# Tap gateway (WS /gateway)
# -----------------------------------------------------------------------------
# Identifies this replica in gateway presence entries and NATS subjects.
# Kubernetes sets this from metadata.name; falls back to HOSTNAME, then to a
# random id. Two replicas sharing one value would each answer for the other's
# connections, so it must be unique per process.
POD_NAME=
# NATS_URL above is what carries a dispatch to the replica holding a tap's
# connection. Without it the gateway still serves taps, but only those
# connected to this same replica are reachable.
#
# Public address of the shared UDP proxy, which taps send audio to while it
# owns the only public IP. Unset once every sink advertises its own address, at
# which point the proxy drops out of the path entirely.
ZK_UDP_PROXY_ADDR=
