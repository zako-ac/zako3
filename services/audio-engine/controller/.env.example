# Audio Engine HTTP server configuration
AE_PORT=8090
# Optional: Explicitly set advertised address. If unset, uses heuristic (hostname or outbound IP).
# Example: "audio-engine-0.audio-engine.default.svc.cluster.local:8090"
# AE_ADVERTISE_ADDR=audio-engine-0.audio-engine.default.svc.cluster.local:8090

# Discord identity. DISCORD_TOKEN is the single-engine / local-dev override.
# DISCORD_TOKENS is a comma-separated pool indexed by this pod's StatefulSet
# ordinal (pod `-N` takes entry N), which is how a multi-replica StatefulSet
# gets one bot per pod. Either way the token also namespaces this engine's
# persisted Redis sessions, so changing it orphans the sessions it would rejoin.
DISCORD_TOKEN=
DISCORD_TOKENS=

# Redis — persists active voice sessions so a restarted AE can rejoin them
REDIS_URL=redis://127.0.0.1:6379

# TapHub configuration
TAPHUB_URL=127.0.0.1:4000
TAPHUB_SNI=localhost
TAPHUB_TRANSPORT_CERT_FILE=transport-cert.pem
# Per-attempt taphub request timeout (retried once on a fresh stream on failure).
# Sized so 2 sequential retried calls fit the 25s command backstop; see config.rs.
TAPHUB_REQUEST_TIMEOUT_MS=6000

# Telemetry (optional)
OTLP_ENDPOINT=http://localhost:5081
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64>,organization=default,stream-name=default
# OTEL_FILTER=debug,h2=off,tonic=off,hyper=off,tower=off,quinn=off,jsonrpsee=off,serenity::gateway=off
METRICS_PORT=9090

# -----------------------------------------------------------------------------
# HQ control plane
# -----------------------------------------------------------------------------
# HQ's internal RPC endpoint. The engine registers here and keeps that
# registration alive, so HQ needs it in every deployment it drives. The default
# points at a locally-running HQ.
HQ_RPC_URL=http://127.0.0.1:50052
HQ_RPC_ADMIN_TOKEN=
# Per-call budget for HQ. Keep under the engine's own per-attempt timeout so a
# slow HQ surfaces as an HQ timeout rather than the generic command backstop.
HQ_REQUEST_TIMEOUT_MS=6000
# -----------------------------------------------------------------------------
# v4 audio plane (optional; off means this engine uses taphub only)
# -----------------------------------------------------------------------------
AUDIO_PLANE_V4=false
# Where this engine receives audio over UDP.
UDP_BIND_ADDR=0.0.0.0:5000
# Reachable from the internet, once this engine has its own public IP. While
# the shared proxy owns the only one, leave this empty and HQ points taps there.
UDP_PUBLIC_ADDR=
# How this engine identifies itself in the sink registry. Must be stable across
# restarts; defaults to POD_NAME, then HOSTNAME.
SINK_ID=
# Cache server, for reading cache hits and writing the tee'd copy.
CACHE_RPC_URL=http://localhost:4100
CACHE_RPC_ADMIN_TOKEN=
