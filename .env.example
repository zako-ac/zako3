# =============================================================================
# Zako3 Docker Compose Environment
# Copy to .env and fill in all required values before running docker compose up
# =============================================================================

# -----------------------------------------------------------------------------
# Infrastructure — PostgreSQL (used by hq)
# -----------------------------------------------------------------------------
POSTGRES_USER=zako3
POSTGRES_PASSWORD=changeme
POSTGRES_DB=zako3

# -----------------------------------------------------------------------------
# Infrastructure — TimescaleDB (used by metrics-sync)
# -----------------------------------------------------------------------------
TIMESCALE_USER=metrics
TIMESCALE_PASSWORD=changeme
TIMESCALE_DB=metrics

# -----------------------------------------------------------------------------
# audio-engine
# -----------------------------------------------------------------------------
AUDIO_DISCORD_TOKEN=
AUDIO_AE_TOKEN=changeme

# -----------------------------------------------------------------------------
# hq
# -----------------------------------------------------------------------------
HQ_RPC_ADMIN_TOKEN=changeme

# Sink id the cache worker advertises under (must match ZK_CACHE_SINK_ID).
# Empty disables the direct preload path: HQ never asks the cache worker for a
# ticket and every preload takes the legacy route, whatever a tap's gateway_v4
# flag says.
HQ_CACHE_SINK_ID=

HQ_DISCORD_CLIENT_ID=
HQ_DISCORD_CLIENT_SECRET=
HQ_DISCORD_REDIRECT_URI=http://localhost:8080/auth/callback
HQ_DISCORD_BOT_TOKEN=

HQ_JWT_SECRET=changeme

# -----------------------------------------------------------------------------
# taphub
# -----------------------------------------------------------------------------
# Must match HQ_RPC_ADMIN_TOKEN (required unless ZK_TH_BYPASS_HQ=true)
ZK_TH_HQ_RPC_ADMIN_TOKEN=changeme

# Paths to TLS certificate and key (mount into the container as needed)
ZK_TH_CERT_FILE=cert.pem
ZK_TH_KEY_FILE=key.pem

# DEBUG ONLY: when true, taphub accepts all tap authentications and audio
# requests without contacting HQ. Loud warning at startup. Do NOT enable in
# production. Off by default.
ZK_TH_BYPASS_HQ=false

# -----------------------------------------------------------------------------
# cache (long-running cache server + background GC)
# -----------------------------------------------------------------------------
ZK_CACHE_DIR=/cache
# Maximum total cache size (bytes). Example: 10737418240 = 10 GiB
ZK_CACHE_MAX_BYTES=
# Background GC interval (seconds). Default = 1800 (30 min).
ZK_CACHE_GC_INTERVAL_SECONDS=1800
# Sidecar reads in flight while the index warms up at startup. Default = 64.
# The server binds and serves before this finishes; until it does, lookups miss.
# Raise it for network-backed volumes where per-file latency dominates.
ZK_CACHE_WARMUP_CONCURRENCY=64
# How long a preload upload may sit idle before it is collected (seconds).
# Default = 300. Generous, because a slow producer must not be cut off — but
# finite, because a producer that dies leaves an entry pointing GET /stream at a
# dead partial file for that cache key. 0 disables the reaper.
ZK_CACHE_PRELOAD_SESSION_TTL_SECONDS=300
# UDP preload ingest — the cache worker as a protofish4 sink, so a preload goes
# tap -> cache with no audio engine in the path. Empty (the default) leaves the
# worker HTTP-only and HQ answers Legacy for every preload.
ZK_CACHE_UDP_BIND_ADDR=
# What the proxy forwards to. Defaults to the bind address, which is wrong under
# a wildcard bind — set it to the address other pods reach this one at.
ZK_CACHE_UDP_INTERNAL_ADDR=
# How this worker is named in the sink registry. HQ must resolve the same id via
# HQ_CACHE_SINK_ID or it has no address to hand a tap. Default = cache.
ZK_CACHE_SINK_ID=cache
# Concurrent transfers. Each holds a reorder window, so this is a memory bound.
# Default = 64.
ZK_CACHE_UDP_MAX_SESSIONS=64
# Set only once this worker has a public IP of its own, at which point taps are
# pointed straight here and the shared proxy drops out of the path.
ZK_CACHE_UDP_PUBLIC_ADDR=
# Optional admin token. If set, taphub must present it via x-admin-token.
ZK_CACHE_ADMIN_TOKEN=
# Token that taphub and hq present to reach the cache server. Must match ZK_CACHE_ADMIN_TOKEN.
# (hq uses it for admin cache management via HQ_CACHE_RPC_ADMIN_TOKEN.)
ZK_TH_CACHE_RPC_ADMIN_TOKEN=

# -----------------------------------------------------------------------------
# ae-proxy (shared UDP relay; temporary, until every sink has its own public IP)
# -----------------------------------------------------------------------------
# See workers/ae-proxy/.env.example for the full set and what each one bounds.
ZK_AEP_MAX_ROUTES=4096
ZK_AEP_MAX_PENDING=512
ZK_AEP_ROUTE_IDLE_SECONDS=300

# Public address HQ hands taps as deliver_to, as host:port. Empty means HQ has
# nowhere to point taps and answers Legacy for every request.
ZK_UDP_PROXY_ADDR=

# -----------------------------------------------------------------------------
# metrics-sync
# -----------------------------------------------------------------------------
METRICS_SYNC_INTERVAL_SECONDS=60
